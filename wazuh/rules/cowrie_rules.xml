<!--
  Custom Wazuh rules for Cowrie honeypot events.
  Fields come from Cowrie's JSON (eventid, src_ip, username, password, input...).
  Rule IDs 100100+ are in the user-custom range.
-->
<group name="cowrie,honeypot,">

  <!-- Base: any decoded Cowrie event -->
  <rule id="100100" level="0">
    <decoded_as>cowrie-json</decoded_as>
    <field name="eventid">\.+</field>
    <description>Cowrie honeypot event.</description>
  </rule>

  <!-- Connection opened -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>Cowrie: new connection from $(src_ip) to honeypot.</description>
    <group>recon,</group>
  </rule>

  <!-- Failed login attempt -->
  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: failed login $(username)/$(password) from $(src_ip).</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Successful login into the honeypot (always suspicious — it's a decoy) -->
  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: SUCCESSFUL login $(username)/$(password) from $(src_ip) — attacker inside honeypot.</description>
    <group>authentication_success,attack,</group>
  </rule>

  <!-- Command executed inside the honeypot -->
  <rule id="100104" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: command run by attacker from $(src_ip): $(input)</description>
    <group>attack,</group>
  </rule>

  <!-- Malware / file download attempt -->
  <rule id="100105" level="12">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>Cowrie: file download attempt from $(src_ip) — possible malware staging.</description>
    <group>malware,attack,</group>
  </rule>

  <!-- Brute force correlation: many failed logins from one IP -->
  <rule id="100110" level="12" frequency="8" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: brute-force — 8+ failed logins from $(src_ip) in 60s.</description>
    <group>authentication_failures,attack,</group>
  </rule>

</group>
